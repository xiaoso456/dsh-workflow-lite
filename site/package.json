{
  "name": "dsh-workflow-lite-site",
  "private": true,
  "type": "module",
  "description": "dsh-workflow-lite 使用文档站（Starlight）。独立的安装单元，不属于插件包。",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs && node scripts/gen-changelog.mjs",
    "predev": "pnpm run sync",
    "dev": "astro dev",
    "prebuild": "pnpm run sync && node scripts/check-settings.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check:settings": "node scripts/check-settings.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.8",
    "astro": "7.3.8",
    "sharp": "0.35.5"
  }
}
